{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // ── Phase 8 deployment config (issue #55) ───────────────────────────────────
  // Full cutover runbook: docs/DEPLOY-PHASE9.md
  //
  // Confirmed (Phase 1/4 — do not change unless reprovisioning):
  //   account_id, database_name, database_id, bucket_name, R2_PUBLIC_URL
  //
  // Custom domains (apex was dashboard-bound at Phase 9.7). www must be
  // listed too — Custom Domains are exact-host matches, so www.diqualia.com
  // does not inherit the apex Worker. Cloudflare creates DNS + certs.
  //
  // Vars vs secrets (production):
  //   vars (wrangler.jsonc):     R2_PUBLIC_URL, NODE_ENV
  //   wrangler secret (required): JWT_SECRET, ADMIN_EMAIL
  //   bindings:                   EMAIL (send_email) — contact form via Cloudflare Email Service
  //                               from: noreply@diqualia.com (domain must be email-sending enabled)
  //   never long-lived secret:    ADMIN_PASSWORD — one-time seed only (scripts/seed-admin.ts)
  //   local preview only:         COOKIE_SECURE=false in .dev.vars
  //   omitted until implemented:  CRON_SECRET (no cron handler in codebase)
  //
  // Phase 1 provisioning (issue #41); account: the owner's Cloudflare account
  // - d1 create diqualia-db: see database_id below
  // - r2 bucket create diqualia-assets: created 2026-07-02 (issue #47)
  // Must match existing dashboard Worker (diqualia-web) so deploy updates in place.
  "name": "diqualia-web",
  "account_id": "YOUR_CLOUDFLARE_ACCOUNT_ID",
  "workers_dev": true,
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "diqualia-db",
      "database_id": "YOUR_D1_DATABASE_ID",
      "migrations_dir": "d1/migrations"
    }
  ],
  "env": {
    "remote": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "diqualia-db",
          "database_id": "YOUR_D1_DATABASE_ID",
          "migrations_dir": "d1/migrations",
          "remote": true
        }
      ]
    }
  },
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "diqualia-assets",
      // Remote so local `next dev` uploads land in the real bucket and are
      // reachable at R2_PUBLIC_URL (r2.dev). Local emulation is invisible to the CDN.
      "remote": true
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "R2_PUBLIC_URL": "https://pub-your-r2-bucket-id.r2.dev"
  },
  "routes": [
    { "pattern": "diqualia.com", "custom_domain": true },
    { "pattern": "www.diqualia.com", "custom_domain": true }
  ],
  // This host disables IPv6 on loopback (`net.ipv6.conf.lo.disable_ipv6=1`).
  // workerd/miniflare default `localhost` tries [::1] and fails with:
  //   ::bind(...): Cannot assign requested address; toString() = [::1]:0
  // Force IPv4 so `next dev` (getPlatformProxy) and wrangler preview both work.
  "dev": {
    "ip": "127.0.0.1"
  }
}
