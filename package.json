{
  "name": "diqualia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:migrate": "wrangler d1 migrations apply diqualia-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply diqualia-db --remote",
    "db:deploy": "wrangler d1 migrations apply diqualia-db --remote",
    "prisma:generate:postgres": "prisma generate --config prisma.config.postgres-export.ts",
    "db:export": "mkdir -p scratch && npm run prisma:generate:postgres && tsx scripts/export-postgres-data.ts > scratch/export.json",
    "db:import:local": "tsx scripts/import-d1-data.ts --local",
    "db:import:remote": "tsx scripts/import-d1-data.ts --remote",
    "db:migrate:validate": "tsx scripts/validate-migration.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:admin": "tsx scripts/seed-admin.ts --local",
    "db:seed:admin:remote": "tsx scripts/seed-admin.ts --remote",
    "db:seed:cms": "tsx prisma/seed-cms.ts",
    "cf:d1:local": "wrangler d1 execute diqualia-db --local",
    "cf:dev": "wrangler dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1061.0",
    "@prisma/adapter-d1": "^7.8.0",
    "@prisma/client": "^7.7.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "prisma": "^7.7.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@opennextjs/cloudflare": "^1.20.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "pg": "^8.16.3",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wrangler": "^4.106.0"
  }
}
