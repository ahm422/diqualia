{
  "name": "diqualia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/ensure-ipv6-loopback.sh && NODE_OPTIONS='--dns-result-order=ipv4first' next dev -H 127.0.0.1",
    "build": "opennextjs-cloudflare build",
    "preview": "bash scripts/ensure-ipv6-loopback.sh && opennextjs-cloudflare preview -- --ip 127.0.0.1",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:migrate": "wrangler d1 migrations apply diqualia-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply diqualia-db --remote",
    "db:deploy": "wrangler d1 migrations apply diqualia-db --remote",
    "db:import:local": "tsx scripts/import-d1-data.ts --local",
    "db:import:remote": "tsx scripts/import-d1-data.ts --remote",
    "db:migrate:validate": "tsx scripts/validate-migration.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:admin": "tsx scripts/seed-admin.ts --local",
    "db:seed:admin:remote": "tsx scripts/seed-admin.ts --remote",
    "db:seed:cms": "tsx prisma/seed-cms.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "bash scripts/ensure-ipv6-loopback.sh && opennextjs-cloudflare preview -- --ip 127.0.0.1",
    "cf:dev": "bash scripts/ensure-ipv6-loopback.sh && opennextjs-cloudflare preview -- --ip 127.0.0.1",
    "cf:d1:local": "wrangler d1 execute diqualia-db --local",
    "cf:e2e": "tsx scripts/e2e-preview.ts",
    "cf:e2e:rbac": "tsx scripts/e2e-rbac.ts",
    "email:test": "tsx scripts/send-test-email.ts",
    "test:cnic": "tsx --test lib/cnic.test.ts",
    "test:career-apply": "tsx --test lib/schemas/public/career-apply.test.ts",
    "test:roles-schema": "tsx --test lib/schemas/admin/roles.test.ts",
    "test:cleanup-drafts": "tsx --test lib/careers/cleanup-drafts.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^7.8.0",
    "@prisma/client": "^7.7.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.7.0",
    "marked": "^18.0.9",
    "next": "16.2.10",
    "prisma": "^7.7.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wrangler": "^4.106.0"
  }
}
