# Node/migration tooling only — NOT Worker runtime secrets.
# Worker preview secrets: copy .dev.vars.example → .dev.vars
# Production secrets: wrangler secret put (see docs/DEPLOY-PHASE9.md)

# --- Migration export only (Phase 9 cutover; remove after Phase 10) ---
# Use Supabase direct connection (port 5432), not pooled (6543).
DIRECT_DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- One-time / local seed (scripts/seed-admin.ts) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-for-seed-only

# --- Optional: corporate SSL proxy during export ---
# DATABASE_SSL_REJECT_UNAUTHORIZED=0

# --- Legacy (Phase 10 removal): only needed for npm run db:seed:cms ---
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
