# Node/seed tooling only — NOT Worker runtime secrets.
# Worker preview secrets: copy .dev.vars.example → .dev.vars
# Production secrets: wrangler secret put (see docs/DEPLOY-PHASE9.md)
#
# Runtime stack: Cloudflare D1 + R2 + Workers + Email Service (EMAIL binding).
# Contact notifications use env.EMAIL.send (noreply@diqualia.com) — no API keys.

# --- One-time / local seed (scripts/seed-admin.ts) ---
# Bootstrap super_admin identity (not a login allowlist). Also used as contact/careers notification recipient.
# ADMIN_EMAIL = admin@example.com
# ADMIN_PASSWORD = change-me-for-seed-only

# --- Next.js image remotePatterns (next.config.ts) ---
# Must match wrangler.jsonc vars.R2_PUBLIC_URL (no surrounding quotes)
R2_PUBLIC_URL = https://pub-your-r2-bucket-id.r2.dev

# --- RAG chatbot (server-side only) ---
# Enable the DeepSeek + Qdrant + Qwen3-Embedding-0.6B path. The chat API
# automatically falls back to the legacy Workers AI assistant when RAG is not
# configured (RAG_ENABLED=false and any required key missing).
#
# DeepSeek (generation LLM):
DEEPSEEK_API_KEY = REMOVED
DEEPSEEK_BASE_URL = https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_MAX_TOKENS=1024
# DEEPSEEK_TIMEOUT_MS=60000
#
# Embeddings — Qwen3-Embedding-0.6B via an OpenAI-compatible endpoint
# (SiliconFlow by default; swap base URL/model to change provider without
# redesigning the pipeline). Keep EMBEDDINGS_DIMENSIONS consistent across
# ingestion and retrieval; never mix models in one Qdrant collection.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDINGS_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDINGS_DIMENSIONS=1024
# EMBEDDINGS_MAX_BATCH=32
#
# Qdrant (vector database):
QDRANT_URL = http://127.0.0.1:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION = diqualia_kb
#
# Retrieval / chunking tuning (optional):
# RAG_ENABLED=true              # force-enable RAG (otherwise auto when keys set)
# RAG_CANDIDATE_K=15            # semantic candidates fetched
# RAG_FINAL_K=6                 # context items kept after dedupe/budget
# RAG_MAX_CONTEXT_TOKENS=2600   # token budget for the context block
# RAG_TARGET_TOKENS=400
# RAG_MAX_TOKENS=700
# RAG_OVERLAP_TOKENS=40
#
# Final chatbot system prompt (supplied separately). Leave unset to use the
# placeholder in chatbot/prompts/systemPrompt.ts.
# CHAT_SYSTEM_PROMPT=
