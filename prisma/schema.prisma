// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

model Lead {
  id        String   @id @default(uuid())
  email     String?
  name      String?
  message   String?
  source    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("leads")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  permissions RolePermission[]
  users       AdminUser[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(uuid())
  key   String           @unique
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AdminUser {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String?
  passwordHash  String         @map("password_hash")
  roleId        String         @map("role_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  role          Role           @relation(fields: [roleId], references: [id])
  refreshTokens RefreshToken[]

  @@map("admin_users")
}

model RefreshToken {
  id          String    @id @default(uuid())
  adminUserId String    @map("admin_user_id")
  tokenHash   String    @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ─── Applicant portal (/portal) ──────────────────────────────────────────────
// Auth surface fully separate from the admin one: distinct cookie
// (dq_portal_token), distinct signing secret (PORTAL_JWT_SECRET), aud "portal".
// Applications link to accounts by lower-cased email (applicantUserId is a
// convenience backfill, no FK).

model ApplicantUser {
  id                 String                  @id @default(uuid())
  email              String                  @unique
  name               String?
  passwordHash       String                  @map("password_hash")
  mustChangePassword Boolean                 @default(true) @map("must_change_password")
  createdAt          DateTime                @default(now()) @map("created_at")
  lastLoginAt        DateTime?               @map("last_login_at")
  refreshTokens      ApplicantRefreshToken[]

  @@map("applicant_users")
}

model ApplicantRefreshToken {
  id              String        @id @default(uuid())
  applicantUserId String        @map("applicant_user_id")
  tokenHash       String        @map("token_hash")
  expiresAt       DateTime      @map("expires_at")
  revokedAt       DateTime?     @map("revoked_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  applicantUser   ApplicantUser @relation(fields: [applicantUserId], references: [id], onDelete: Cascade)

  @@index([applicantUserId])
  @@index([tokenHash])
  @@map("applicant_refresh_tokens")
}

// ─── Global ──────────────────────────────────────────────────────────────────

model SiteSettings {
  id       Int     @id @default(1)
  siteName String  @map("site_name")
