// ─── Blog / Insights ─────────────────────────────────────────────────────────

model BlogPost {
  id            String    @id @default(uuid())
  slug          String    @unique
  title         String
  excerpt       String
  body          String
  coverImageUrl String?   @map("cover_image_url")
  status        String    @default("draft") // draft | published
  publishedAt   DateTime? @map("published_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("blog_posts")
}

// ─── Careers ────────────────────────────────────────────────────────────────

model CareerPage {
  id             Int    @id @default(1)
  eyebrow        String
  headlineLine1  String @map("headline_line1")
  headlineLine2  String @map("headline_line2")
  body           String
  cultureEyebrow String @map("culture_eyebrow")
  cultureHeadline String @map("culture_headline")
  cultureBody    String @map("culture_body")
  benefits       Json
  applyEyebrow   String @map("apply_eyebrow")
  applyHeadline  String @map("apply_headline")
  applyBody      String @map("apply_body")

  @@map("career_page")
}

model JobOpening {
  id               Int              @id @default(autoincrement())
  slug             String           @unique
  title            String
  department       String
  location         String
  type             String
  description      String
  responsibilities Json             @default("[]")
  requirements     Json
  niceToHave       Json?            @map("nice_to_have")
  seniority        String?
  salaryRange      String?          @map("salary_range")
  remote           String?
  teamNote         String?          @map("team_note")
  order            Int
  visible          Boolean          @default(true)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  applications     JobApplication[]
  drafts           CareerApplicationDraft[]

  @@map("job_openings")
}

model JobApplication {
  id                  String      @id @default(uuid())
  name                String
  email               String
  phone               String?
  jobOpeningId        Int?        @map("job_opening_id")
  jobTitle            String      @map("job_title")
  coverNote           String?     @map("cover_note")
  resumeKey           String      @map("resume_key")
  status              String      @default("new")
  submittedAt         DateTime    @default(now()) @map("submitted_at")
  fatherOrHusbandName String?     @map("father_or_husband_name")
  dateOfBirth         String?     @map("date_of_birth")
  gender              String?
  maritalStatus       String?     @map("marital_status")
  cnic                String?
  nationality         String?
  currentAddress      String?     @map("current_address")
  city                String?
  highestQualification String?    @map("highest_qualification")
  fieldOfStudy        String?     @map("field_of_study")
  institutionName     String?     @map("institution_name")
  yearOfCompletion    Int?        @map("year_of_completion")
  yearsOfExperience   Int?        @map("years_of_experience")
  currentEmployer     String?     @map("current_employer")
  currentJobTitle     String?     @map("current_job_title")
  keySkills           String?     @map("key_skills")
  noticePeriodDays    Int?        @map("notice_period_days")
  expectedSalary      Int?        @map("expected_salary")
  availableFrom       String?     @map("available_from")
  photoKey            String?     @map("photo_key")
  declarationAccepted Boolean     @default(false) @map("declaration_accepted")
  applicantUserId     String?     @map("applicant_user_id")
  jobOpening          JobOpening? @relation(fields: [jobOpeningId], references: [id], onDelete: SetNull)

  @@unique([jobOpeningId, email], map: "job_applications_opening_email_key")
  @@unique([jobOpeningId, cnic], map: "job_applications_opening_cnic_key")
  @@index([jobOpeningId])
  @@index([status])
  @@index([applicantUserId])
  @@map("job_applications")
}

// Stale-draft retention (issue #102): status = 'in_progress' drafts with
// updatedAt older than 30 days (and no matching JobApplication) are
// hard-deleted by the daily cleanup Cron Trigger — see
// lib/careers/cleanup-drafts.ts. status = 'completed' drafts are retained
// indefinitely (their resume/photo R2 keys are shared with the resulting
// JobApplication row).
model CareerApplicationDraft {
  token        String   @id
  jobOpeningId Int      @map("job_opening_id")
  status       String   @default("in_progress")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  jobOpening   JobOpening @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  personal     CareerApplicationDraftPersonal?
  education    CareerApplicationDraftEducation?
  professional CareerApplicationDraftProfessional?
  other        CareerApplicationDraftOther?

  @@index([status, updatedAt])
  @@map("career_application_drafts")
}

model CareerApplicationDraftPersonal {
  draftToken          String  @id @map("draft_token")
  name                String
  email               String
  phone               String
  fatherOrHusbandName String? @map("father_or_husband_name")
  dateOfBirth         String  @map("date_of_birth")
  gender              String
  maritalStatus       String? @map("marital_status")
  nationality         String
  cnic                String?
  currentAddress      String  @map("current_address")
  city                String
  draft               CareerApplicationDraft @relation(fields: [draftToken], references: [token], onDelete: Cascade)

  @@map("career_application_draft_personal")
}

model CareerApplicationDraftEducation {
  draftToken           String  @id @map("draft_token")
  highestQualification String  @map("highest_qualification")
  fieldOfStudy         String? @map("field_of_study")
  institutionName      String? @map("institution_name")
  yearOfCompletion     Int?    @map("year_of_completion")
  draft                CareerApplicationDraft @relation(fields: [draftToken], references: [token], onDelete: Cascade)

  @@map("career_application_draft_education")
}

model CareerApplicationDraftProfessional {
  draftToken        String  @id @map("draft_token")
  yearsOfExperience Int     @map("years_of_experience")
  currentEmployer   String? @map("current_employer")
  currentJobTitle   String? @map("current_job_title")
  coverNote         String? @map("cover_note")
  draft             CareerApplicationDraft @relation(fields: [draftToken], references: [token], onDelete: Cascade)

  @@map("career_application_draft_professional")
}

model CareerApplicationDraftOther {
  draftToken          String  @id @map("draft_token")
  keySkills           String  @map("key_skills")
  noticePeriodDays    Int     @map("notice_period_days")
  expectedSalary      Int     @map("expected_salary")
  availableFrom       String  @map("available_from")
  resumeKey           String? @map("resume_key")
  photoKey            String? @map("photo_key")
  declarationAccepted Boolean @default(false) @map("declaration_accepted")
  draft               CareerApplicationDraft @relation(fields: [draftToken], references: [token], onDelete: Cascade)

  @@map("career_application_draft_other")
}
